# ---------------------------------------------------------------------------
# apps/meteor — local source development (`yarn dev`)
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. All vars are OPTIONAL for a first run:
# with none set, Meteor starts its own bundled MongoDB and the app boots.
# Set MONGO_URL/MONGO_OPLOG_URL when you want an external replica-set Mongo
# (required for some real-time features and to mirror production).
# See docs/getting-started.md.

# HTTP port the Meteor app listens on.
PORT=3000

# Public URL the app is served from. Must match how you open it in the browser.
ROOT_URL=http://localhost:3000

# External MongoDB. Leave UNSET to use Meteor's bundled Mongo (simplest).
# Rocket.Chat needs a replica set (oplog) for full real-time behavior.
# MONGO_URL=mongodb://localhost:27017/rocketchat?replicaSet=rs0
# MONGO_OPLOG_URL=mongodb://localhost:27017/local?replicaSet=rs0

# Inter-service transport. Only relevant in microservices mode (`yarn ms`).
# Defaults to TCP; set NATS when running the ddp-streamer/presence/etc. services.
# TRANSPORTER=nats://localhost:4222
# MOLECULER_LOG_LEVEL=info

# Outgoing email. Unset = emails are logged to console instead of sent.
# MAIL_URL=smtp://user:pass@localhost:1025

# Enterprise license (EE features). Unset = Community Edition.
# ROCKETCHAT_LICENSE=

# Lower the log level number for more verbose logs (0 = most verbose).
# OVERWRITE_SETTING_Log_Level=2
