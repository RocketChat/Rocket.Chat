# =============================================================================
# apps/meteor/.env.example  —  local source development (`yarn dev`)
# =============================================================================
# This file doubles as documentation: it lists the env vars that actually
# affect a local dev run, grouped by concern, with defaults and gotchas.
#
# HOW IT IS LOADED
#   `yarn dev` wraps meteor with dotenv-cli, which reads this file (copied to
#   `.env` on first run) into the environment BEFORE the meteor tool starts.
#   That ordering matters: vars the meteor *tool* consumes (MONGO_URL, PORT,
#   ROOT_URL) must be present before boot, so app-side loaders (e.g. Node's
#   --env-file via SERVER_NODE_OPTIONS) are too late for those specific vars.
#
# PRECEDENCE
#   A var already exported in your shell wins over this file (dotenv/Node
#   semantics). Comment a var out to fall back to the app's built-in default.
#
# EVERYTHING HERE IS OPTIONAL for a first run: with nothing set, meteor boots
# its own bundled MongoDB (a single-node replica set, so transactions and
# change streams work) and the app comes up on http://localhost:3000.
# =============================================================================


# -----------------------------------------------------------------------------
# Node runtime flags  (allowed inside NODE_OPTIONS — unlike --env-file)
# -----------------------------------------------------------------------------
NODE_OPTIONS=--trace-warnings
# NODE_ENV=development


# -----------------------------------------------------------------------------
# Core server  (read by the meteor tool at boot — see "HOW IT IS LOADED")
# -----------------------------------------------------------------------------
# HTTP port the app listens on.
PORT=3000

# Public URL the app is served from. MUST match how you open it in the browser,
# otherwise logins / OAuth / websockets misbehave.
ROOT_URL=http://localhost:3000

# External MongoDB. Leave UNSET to use meteor's bundled Mongo (simplest).
# Set this ONLY if you want an external Mongo — e.g. to mirror production, or
# to inspect data with an external client. A replica set is required (for
# transactions + change streams, NOT for oplog — see MONGO_OPLOG_URL below).
# MONGO_URL=mongodb://localhost:27017/rocketchat?replicaSet=rs0

# NO-OP in Rocket.Chat: the app hard-disables Meteor oplog tailing
# (apps/meteor/packages/rocketchat-mongo-config/server/index.js sets
# Package['disable-oplog']). Real-time is delivered by the streamer, not the
# oplog. Kept here only to document that setting it has no effect.
# MONGO_OPLOG_URL=mongodb://localhost:27017/local?replicaSet=rs0

# Extra MongoDB driver connection options, as a JSON string. Merged over the
# defaults (retryWrites=false is auto-added when absent from MONGO_URL).
# MONGO_OPTIONS={"maxPoolSize":10}


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# SMTP endpoint. UNSET = outgoing emails are logged/swallowed, not sent.
# MAIL_URL=smtp://user:pass@localhost:1025


# -----------------------------------------------------------------------------
# Enterprise (EE)
# -----------------------------------------------------------------------------
# Enterprise license. UNSET = Community Edition.
# (Note: the docker-compose stack reads this as ENTERPRISE_LICENSE instead.)
# ROCKETCHAT_LICENSE=


# -----------------------------------------------------------------------------
# Automated first-run setup  (skips the Setup Wizard — great for fresh DBs)
# apps/meteor/server/startup/initialData.ts
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASS=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_EMAIL_VERIFIED=true
# ADMIN_NAME=Administrator
# Seed an extra non-admin user as "user:pass".
# INITIAL_USER={"username":"user","password":"pass"}


# -----------------------------------------------------------------------------
# Logging & debugging
# -----------------------------------------------------------------------------
# Log verbosity via the settings-override mechanism (see next section).
# 0 = most verbose, 2 = default-ish.
# OVERWRITE_SETTING_Log_Level=0

# Log every settings add/override as it is applied.
# DEBUG_SETTINGS=true

# Log rate-limiter decisions.
# RATE_LIMITER_LOGGER=true

# Print model-layer warnings (packages/models/src/models/BaseRaw.ts).
# SHOW_WARNINGS=true

# Throw (instead of warn) on deprecated API usage below a given version.
# ROCKET_CHAT_DEPRECATION_THROW_ERRORS_FOR_VERSIONS_UNDER=


# -----------------------------------------------------------------------------
# Settings override via env  (apps/meteor/app/settings/server/functions/)
# -----------------------------------------------------------------------------
# Two mechanisms exist:
#   OVERWRITE_SETTING_<Setting_Id>=value   -> forces a setting, admin UI locked
#   <Setting_Id>=value                     -> seeds a setting's initial value
# The <Setting_Id> is the internal key (e.g. Log_Level, Site_Url, FileUpload_Storage_Type).
# Examples:
# OVERWRITE_SETTING_Site_Url=http://localhost:3000
# OVERWRITE_SETTING_Iframe_Restrict_Access=false

# Setup-wizard / settings guards (rarely needed in dev):
# SETTINGS_BLOCKED=
# SETTINGS_HIDDEN=
# SETTINGS_REQUIRED_ON_WIZARD=


# -----------------------------------------------------------------------------
# Startup validation bypasses  (apps/meteor/server/startup/serverRunning.ts)
# Use sparingly — they exist to get unblocked, not as a default.
# -----------------------------------------------------------------------------
# BYPASS_MONGO_VALIDATION=true
# BYPASS_NODEJS_VALIDATION=true
# SKIP_MONGODEPRECATION_CHECK=true
# SKIP_MONGODEPRECATION_BANNER=true
# Auto-accept the Apps-Engine fingerprint change prompt on boot.
# AUTO_ACCEPT_FINGERPRINT=true


# -----------------------------------------------------------------------------
# Dev feature toggles
# -----------------------------------------------------------------------------
# Disable admin "custom scripts" injection.
# DISABLE_CUSTOM_SCRIPTS=true
# Disable UI animations (useful for e2e / perf profiling).
# DISABLE_ANIMATION=true
# Skip the markdown/message parser listener.
# DISABLE_MESSAGE_PARSER=true
# Disable integration (incoming/outgoing webhook) trigger scripts.
# DISABLE_INTEGRATION_SCRIPTS=true
# Don't phone home usage statistics.
# RC_DISABLE_STATISTICS_REPORTING=true
# Drop the message round-trip timing instrumentation.
# DISABLE_MESSAGE_ROUNDTRIP_TRACKING=true


# -----------------------------------------------------------------------------
# Metrics & tracing
# -----------------------------------------------------------------------------
# Prometheus scrape port (monolith). Default 9458.
# PROMETHEUS_PORT=9458
# Enable MongoDB command monitoring / tracing spans.
# TRACING_ENABLED=true


# -----------------------------------------------------------------------------
# Networking / misc
# -----------------------------------------------------------------------------
# Number of trusted reverse proxies in front of the app (X-Forwarded-For).
# Defaults to 1 (set by rocketchat-mongo-config if unset).
# HTTP_FORWARDED_COUNT=1
# Default timeout (ms) for server-side outbound HTTP calls.
# HTTP_DEFAULT_TIMEOUT=
# Max simultaneous resume-login tokens per user.
# MAX_RESUME_LOGIN_TOKENS=
# Override the URL/DDP endpoint advertised to mobile clients.
# MOBILE_ROOT_URL=
# MOBILE_DDP_URL=


# =============================================================================
# Microservices mode  (`yarn ms`)  —  ee/packages/network-broker/src/index.ts
# =============================================================================
# Only relevant when running services (ddp-streamer, presence, authorization,
# account, queue-worker, omnichannel-transcript). Ignored in monolith `yarn dev`.
#
# Inter-service transport. Empty/absent => TCP (Moleculer default). For the
# full local stack use NATS:
# TRANSPORTER=nats://localhost:4222
#
# MS_NAMESPACE=
# CACHE=Memory
# SERIALIZER=EJSON
# MOLECULER_LOG_LEVEL=warn
# REQUEST_TIMEOUT=60
# HEARTBEAT_INTERVAL=10
# HEARTBEAT_TIMEOUT=30
# BALANCE_STRATEGY=RoundRobin
# BALANCE_PREFER_LOCAL=true
# RETRY_ENABLED=false
# RETRY_RETRIES=5
# RETRY_DELAY=100
# RETRY_MAX_DELAY=1000
# RETRY_FACTOR=2
# BULKHEAD_ENABLED=false
# BULKHEAD_CONCURRENCY=10
# BULKHEAD_MAX_QUEUE_SIZE=10000
# MS_METRICS=false
# MS_METRICS_PORT=9458
# SKIP_PROCESS_EVENT_REGISTRATION=false


# =============================================================================
# Alternative loader (zero new dependency)
# =============================================================================
# Instead of the dotenv-cli wrapper you can rely on Node's native loader via
# Meteor's server flag passthrough:
#
#   SERVER_NODE_OPTIONS="--env-file-if-exists=.env" yarn dev
#
# Caveat: this loads the file into the *server* process only, and env wins over
# file — so MONGO_URL / PORT / ROOT_URL (managed by the meteor tool) won't be
# reliably overridden this way. It's fine for MAIL_URL, ROCKETCHAT_LICENSE,
# OVERWRITE_SETTING_*, log levels and custom vars.
# =============================================================================
