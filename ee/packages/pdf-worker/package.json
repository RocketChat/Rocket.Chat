{
	"name": "@rocket.chat/pdf-worker",
	"version": "0.3.36",
	"private": true,
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && cp -r src/public dist/public",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"storybook": "storybook dev -p 6006",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@react-pdf/renderer": "~4.5.1",
		"@rocket.chat/core-typings": "workspace:^",
		"@rocket.chat/fuselage-tokens": "workspace:^",
		"emojibase-data": "^17.0.0",
		"moment": "^2.31.0",
		"moment-timezone": "^0.5.48",
		"react": "~19.2.8",
		"react-i18next": "~17.0.16"
	},
	"devDependencies": {
		"@rocket.chat/jest-presets": "workspace:~",
		"@rocket.chat/message-parser": "workspace:~",
		"@rocket.chat/storybook-config": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:*",
		"@storybook/react": "~9.1.21",
		"@storybook/react-webpack5": "~9.1.21",
		"@testing-library/dom": "~10.4.2",
		"@testing-library/react": "~16.3.3",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"buffer": "~6.0.3",
		"emojibase": "^17.0.0",
		"i18next": "~26.4.2",
		"jest": "~30.5.2",
		"path-browserify": "^1.0.1",
		"react-dom": "~19.2.8",
		"storybook": "~9.1.21",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../../package.json"
	}
}
