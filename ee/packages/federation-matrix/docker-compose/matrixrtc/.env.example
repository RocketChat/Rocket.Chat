# Copy to .env (or run ./init-env.sh, which fills it in). .env is gitignored: never commit it.

# Directory with rc1.pem, rc2.pem, hs1.pem, element.pem (+ -key.pem) and ca/rootCA.crt,
# all signed by a CA the host trusts (mkcert).
CERTS_DIR=/path/to/matrix-homeserver-local/traefik/certs

# Image built by ./build-image.sh
RC_IMAGE=rocketchat/rocket.chat:matrixrtc-poc

# One enterprise licence per server.
ENTERPRISE_LICENSE_RC1=
ENTERPRISE_LICENSE_RC2=

# ed25519 signing keys (base64 seed), one per server.
MATRIX_SIGNING_KEY_RC1=
MATRIX_SIGNING_KEY_RC2=

# LiveKit API key pairs, one per SFU. Dev-only values; the secret needs at least 32 characters.
LIVEKIT1_API_KEY=
LIVEKIT1_API_SECRET=
LIVEKIT2_API_KEY=
LIVEKIT2_API_SECRET=

# Optional overrides
# RC_LOG_LEVEL=debug
# RC_TEST_MODE=api
# LIVEKIT_LOG_LEVEL=info
# MONGO_HOST_PORT=27037
# LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7
