{
	"$schema": "../../../node_modules/oxlint/configuration_schema.json",
	"extends": ["../../../.oxlintrc.json"],
	"settings": {
		"react": {
			"version": "19.2"
		}
	},
	"overrides": [
		{
			"files": ["**/*.{test,spec}.ts"],
			"plugins": ["jest"],
			"rules": {
				"jest/no-disabled-tests": "off"
			}
		}
	]
}
