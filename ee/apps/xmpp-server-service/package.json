		"moleculer": "^0.14.36",
		"mongodb": "6.16.0",
		"nats": "^2.28.2",
		"pino": "10.3.1",
		"polka": "^0.5.2",
		"prom-client": "^14.2.0"
	},
	"devDependencies": {
		"@rocket.chat/tsconfig": "workspace:*",
		"@types/polka": "^0.5.8",
