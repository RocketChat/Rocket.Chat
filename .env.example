# ---------------------------------------------------------------------------
# Root .env.example — used by docker-compose-local.yml
# ---------------------------------------------------------------------------
# This stack runs Rocket.Chat + microservices from PREBUILT images
# (ghcr.io/<repo>/...), not from your local source. Use it to bring up a full
# microservices environment (Mongo replica set, NATS, Traefik, ddp-streamer,
# presence, account, authorization, queue-worker, omnichannel-transcript).
#
# For developing the app FROM SOURCE, use `yarn dev` instead and see
# apps/meteor/.env.example + docs/getting-started.md.
#
# Copy to `.env`, then: docker compose -f docker-compose-local.yml up

# GHCR image coordinates (lowercase org/repo) and tag to pull.
LOWERCASE_REPOSITORY=rocketchat/rocket.chat
DOCKER_TAG=latest

# MongoDB replica set (the compose file boots a single-node rs0).
MONGODB_VERSION=8.0
MONGODB_REPLICA_SET_NAME=rs0
MONGODB_PORT_NUMBER=27017
MONGODB_INITIAL_PRIMARY_HOST=mongo

# Connection strings the app + services use to reach Mongo.
MONGO_URL=mongodb://mongo:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://mongo:27017/local?replicaSet=rs0

# Inter-service transport. NATS is started by the compose stack.
TRANSPORTER=nats://nats:4222

# Enterprise license for EE features. Leave empty for Community Edition.
ENTERPRISE_LICENSE=
