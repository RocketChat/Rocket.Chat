+  --rcx-item-inset-inline: 1.25rem;
+}
+.rcx-item-group-header--sticky {
+  position: sticky;
+  z-index: 2;
+  top: 0;
+  background-color: var(--rcx-item-group-header-color-surface, var(--rcx-color-surface-light, #ffffff));
+}
+.rcx-item-group-header:has(.rcx-item-group-title:is(button)):hover {
+  background-color: var(--rcx-item-color-surface-hover, var(--rcx-color-surface-hover, #f2f3f5));
+}
+.rcx-item-group-header:has(.rcx-item-group-title:is(button):focus-visible) {
+  outline: 0;
+  box-shadow: inset 0 0 0 2px var(--rcx-item-color-stroke-focus, var(--rcx-color-stroke-highlight, #156ff5));
+}
+.rcx-item-group-header:hover .rcx-item__actions--reveal-hover, .rcx-item-group-header:focus-within .rcx-item__actions--reveal-hover, .rcx-item-group-header:has(.rcx-item__actions [aria-expanded=true]) .rcx-item__actions--reveal-hover {
+  opacity: 1;
+  grid-template-columns: 1fr;
+}
+.rcx-item-group-header .rcx-item__meta {
+  font-weight: 400;
+}
+
+.rcx-item-group-title {
+  overflow: hidden;
+  flex: 1 1 auto;
+  min-width: 0;
+  margin: 0;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  color: inherit;
+  font: inherit;
+}
+.rcx-item-group-title:is(button) {
+  display: flex;
+  align-items: center;
+  padding: 0;
+  cursor: pointer;
+  text-align: start;
+  border: 0;
+  outline: 0;
+  background: none;
+  gap: 0.25rem;
+}
+.rcx-item-group-title:is(button)::after {
+  position: absolute;
+  inset: 0;
+  content: "";
+  border-radius: inherit;
+}
+
+.rcx-item-divider {
+  --rcx-item-inset-inline: 0;
+  display: block;
+  margin: 0;
+  padding-block: 0.25rem;
+  padding-inline: 0;
+  list-style: none;
+  border: 0;
+}
+.rcx-item-divider--inset-sm {
+  --rcx-item-inset-inline: 0.25rem;
+}
+.rcx-item-divider--inset-md {
+  --rcx-item-inset-inline: 0.5rem;
+}
+.rcx-item-divider--inset-lg {
+  --rcx-item-inset-inline: 1.25rem;
+}
+.rcx-item-divider::before {
+  display: block;
+  content: "";
+  border-top: 1px solid var(--rcx-item-color-stroke-divider, var(--rcx-color-stroke-extra-light, #ebecef));
+}
+.rcx-item-divider--inset-sm, .rcx-item-divider--inset-md, .rcx-item-divider--inset-lg {
+  margin-inline: calc(0.25rem + var(--rcx-item-inset-inline));
+}
+
+@container rcx-item-group (width < 320px) {
+  .rcx-item--inset-lg,
+  .rcx-item-group-header--inset-lg,
+  .rcx-item-divider--inset-lg {
+    --rcx-item-inset-inline: 0.75rem;
+  }
+  .rcx-item__description--inline {
+    display: block;
+    margin-inline-start: 0;
+  }
+}
+@media (pointer: coarse) {
+  .rcx-item {
+    padding-block: 0.5rem;
+  }
+}
+@media (hover: none) {
+  .rcx-item .rcx-item__actions--reveal-hover,
+  .rcx-item-group-header .rcx-item__actions--reveal-hover {
+    opacity: 1;
+    grid-template-columns: 1fr;
+  }
+}
 .rcx-label {
   letter-spacing: 0rem;
   font-size: 0.875rem;
