{
	"extends": "@rocket.chat/tsconfig/server.json",
	"compilerOptions": {
		"declaration": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["./src/**/*"],
	// a child `exclude` replaces the parent's rather than adding to it; keeping only `node_modules`
	// lets oxlint and `yarn typecheck` cover the specs, while the build config drops them.
	"exclude": ["node_modules"]
}
