{
	"name": "@rocket.chat/css-supports",
	"version": "0.31.27-rc.0",
	"description": "Memoized and SSR-compatible facade of CSS.supports API",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bugs": {
		"url": "https://github.com/RocketChat/Rocket.Chat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/css-supports"
	},
	"license": "MIT",
	"author": {
		"name": "Rocket.Chat",
		"url": "https://rocket.chat/"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rocket.chat/memo": "workspace:~"
	},
	"devDependencies": {
		"@rocket.chat/jest-presets": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:~",
		"jest": "~30.5.2",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
