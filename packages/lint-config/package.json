{
	"name": "@rocket.chat/lint-config",
	"version": "0.1.0-rc.0",
	"description": "Rocket.Chat's JS/TS oxlint config",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/lint-config"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		"./oxlint.json": "./oxlint.json",
		"./rules": "./rules/index.js"
	},
	"files": [
		"/oxlint.json",
		"/oxlint-eslint-rules.js",
		"/rules"
	],
	"scripts": {
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix"
	},
	"dependencies": {
		"eslint": "~10.12.0",
		"eslint-plugin-anti-trojan-source": "~1.1.7",
		"eslint-plugin-import-x": "~4.17.1",
		"eslint-plugin-jest": "~29.16.6",
		"eslint-plugin-jsx-a11y": "~6.10.2",
		"eslint-plugin-prettier": "~5.5.6",
		"eslint-plugin-react": "~7.37.5",
		"eslint-plugin-storybook": "9.1.20",
		"eslint-plugin-testing-library": "~7.16.2",
		"prettier": "~3.9.9"
	},
	"devDependencies": {
		"storybook": "^9.1.20",
		"typescript": "~5.9.3"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"installConfig": {
		"hoistingLimits": "workspaces"
	}
}
