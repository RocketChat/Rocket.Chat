{
	"name": "@rocket.chat/media-signaling",
	"description": "Rocket.Chat signaling client for media calls",
	"version": "1.3.0-rc.0",
	"license": "MIT",
	"homepage": "https://github.com/RocketChat/Rocket.Chat/#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/media-signaling"
	},
	"bugs": {
		"url": "https://github.com/RocketChat/Rocket.Chat/issues"
	},
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"build-preview": "mkdir -p ../../.preview && cp -r ./dist ../../.preview/media-signaling",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rocket.chat/emitter": "workspace:~",
		"ajv": "^8.20.0"
	},
	"devDependencies": {
		"@rocket.chat/jest-presets": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:*",
		"eslint": "~10.11.0",
		"jest": "~30.5.2",
		"typescript": "~6.0.3"
	}
}
