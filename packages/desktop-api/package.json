{
	"$schema": "https://www.schemastore.org/package",
	"name": "@rocket.chat/desktop-api",
	"version": "1.4.0-rc.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/desktop-api"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
