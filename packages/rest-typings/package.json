		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"@rocket.chat/apps-engine": "workspace:^",
		"mongodb": "6.16.0",
		"tsx": "~4.22.5",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
