{
	"$schema": "https://json.schemastore.org/package",
	"name": "@rocket.chat/apps-runtime",
	"version": "0.0.0",
	"private": true,
	"description": "Apps v2 host runtime: worker-thread orchestration, JSON-RPC host↔worker protocol, and the in-worker bootstrap.",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.json",
		"dev": "tsc --watch --preserveWatchOutput -p tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "tsc -p tsconfig.json && node --test \"dist/__tests__/*.test.js\"",
		"driver": "node dist/driver.js"
	},
	"dependencies": {
		"@rocket.chat/apps-sdk": "workspace:^",
		"tar": "^7.5.13"
	},
	"devDependencies": {
		"@rocket.chat/tsconfig": "workspace:^",
		"@types/node": "~22.19.17",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
