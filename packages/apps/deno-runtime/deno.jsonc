{
	"imports": {
		"@msgpack/msgpack": "npm:@msgpack/msgpack@3.0.0-beta2",
		"@rocket.chat/ui-kit": "npm:@rocket.chat/ui-kit@^0.31.22",
		"@rocket.chat/apps-engine/": "../../../packages/apps-engine/",
		"@rocket.chat/apps/base-runtime/": "../base-runtime/src/",
		"@rocket.chat/apps/": "../",
		"@std/io": "jsr:@std/io@^0.225.3",
		"acorn": "npm:acorn@8.17.0",
		"acorn-walk": "npm:acorn-walk@8.3.5",
		"astring": "npm:astring@1.8.6",
		"jsonrpc-lite": "npm:jsonrpc-lite@2.2.0",
		"stack-trace": "npm:stack-trace@0.0.10",
		"uuid": "npm:uuid@8.3.2"
	},
	"unstable": ["detect-cjs", "sloppy-imports"],
	"compilerOptions": {
		"strict": false
	},
	"tasks": {
		"test": "deno test --no-check --allow-read --allow-write --allow-env"
	},
	"fmt": {
		"lineWidth": 160,
		"useTabs": true,
		"indentWidth": 4,
		"singleQuote": true
	},
	"lint": {
		"rules": {
			"exclude": ["no-sloppy-imports"]
		}
	}
}
