{
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.tool-versions"],
            "outputs": [
                "base-runtime/**",
                "node-runtime/**",
                "deno-runtime/**",
                "scripts/**",
                ".deno-cache/**",
                "dist/**",
                "!.deno-cache/**/*-shm",
                "!.deno-cache/**/*-wal"
            ]
        }
    }
}
