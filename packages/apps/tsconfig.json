{
	"extends": "@rocket.chat/tsconfig/server.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"declaration": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"lib": ["es2023", "dom"],
		"strict": false,
		"noUnusedParameters": false,
		"noImplicitOverride": false,
		"noImplicitReturns": false
	},
	"include": ["./src/**/*"]
}
