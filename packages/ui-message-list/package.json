{
	"name": "@rocket.chat/ui-message-list",
	"version": "0.0.1",
	"private": true,
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"sdlc:check": "node scripts/sdlc/sdlc-check.mjs .",
		"sdlc:evals": "node scripts/sdlc/run-evals.mjs .",
		"storybook": "storybook dev -p 6007",
		"test": "jest",
		"test-storybook": "TZ=UTC npx concurrently -k -s first -n \"SB,TEST\" \"yarn storybook --ci\" \"npx wait-on tcp:127.0.0.1:6007 && yarn exec test-storybook --url http://127.0.0.1:6007\"",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dompurify": "~3.4.17"
	},
	"devDependencies": {
		"@react-aria/toolbar": "^3.0.0-nightly.5042",
		"@rocket.chat/core-typings": "workspace:^",
		"@rocket.chat/css-in-js": "workspace:^",
		"@rocket.chat/fuselage": "workspace:~",
		"@rocket.chat/fuselage-hooks": "workspace:^",
		"@rocket.chat/icons": "workspace:~",
		"@rocket.chat/jest-presets": "workspace:~",
		"@rocket.chat/message-parser": "workspace:^",
		"@rocket.chat/mock-providers": "workspace:^",
		"@rocket.chat/storybook-config": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:*",
		"@rocket.chat/ui-avatar": "workspace:^",
		"@rocket.chat/ui-client": "workspace:^",
		"@rocket.chat/ui-contexts": "workspace:^",
		"@storybook/react": "~10.6.5",
		"@storybook/test-runner": "~0.26.0",
		"@tanstack/react-query": "~5.65.1",
		"@testing-library/react": "~16.3.3",
		"@testing-library/user-event": "~14.6.7",
		"@types/jest-axe": "~3.5.9",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"i18next": "~26.4.2",
		"jest": "~30.5.2",
		"jest-axe": "~11.0.0",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"react-i18next": "~17.0.16",
		"storybook": "~10.6.5",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"peerDependencies": {
		"@react-aria/toolbar": "*",
		"@rocket.chat/core-typings": "workspace:^",
		"@rocket.chat/css-in-js": "workspace:^",
		"@rocket.chat/fuselage": "*",
		"@rocket.chat/fuselage-hooks": "*",
		"@rocket.chat/icons": "*",
		"@rocket.chat/message-parser": "workspace:^",
		"@rocket.chat/ui-avatar": "workspace:^",
		"@rocket.chat/ui-client": "workspace:^",
		"@rocket.chat/ui-contexts": "workspace:^",
		"@tanstack/react-query": "*",
		"react": "*",
		"react-i18next": "*"
	}
}
