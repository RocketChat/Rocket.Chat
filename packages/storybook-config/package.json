{
	"name": "@rocket.chat/storybook-config",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./app-root": {
			"types": "./dist/appRoot.d.ts",
			"default": "./dist/appRoot.js"
		},
		"./main": {
			"types": "./dist/main.d.ts",
			"default": "./dist/main.js"
		},
		"./preset": {
			"types": "./dist/preset.d.ts",
			"default": "./dist/preset.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"default": "./dist/preview.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc && yarn run copy-svg",
		"copy-svg": "cp -r ./src/logo.svg ./dist/logo.svg",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rocket.chat/emitter": "workspace:~",
		"@rocket.chat/fuselage-hooks": "workspace:^",
		"@rocket.chat/fuselage-tokens": "workspace:^",
		"@rocket.chat/i18n": "workspace:~",
		"@storybook/addon-a11y": "~10.6.5",
		"@storybook/addon-docs": "~10.6.5",
		"@storybook/addon-styling-webpack": "~3.0.2",
		"@storybook/addon-webpack5-compiler-swc": "^4.0.3",
		"@storybook/react-webpack5": "~10.6.5",
		"react-virtuoso": "~4.18.16",
		"storybook": "~10.6.5",
		"webpack": "~5.104.1"
	},
	"devDependencies": {
		"@rocket.chat/fuselage": "workspace:~",
		"@rocket.chat/icons": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:*",
		"@storybook/react": "~10.6.5",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"@rocket.chat/fuselage": "1.0.0",
		"@rocket.chat/icons": "0.52.0",
		"@storybook/react": "*",
		"react": "*"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
