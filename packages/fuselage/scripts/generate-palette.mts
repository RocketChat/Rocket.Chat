// Writes the light palette `PaletteStyleTag` writes as the SCSS map the stylesheets fall back to, since Sass cannot
// compute it. The other themes reach a stylesheet only through the custom properties `PaletteStyleTag` declares.
//
//   yarn generate:palette          rewrite src/styles/palette.scss
//   yarn generate:palette --check  fail if it is stale (what `yarn test:verify` runs)
//
// Run it after building `@rocket.chat/fuselage-tokens`.
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

import prettier from 'prettier';

import { getThemePalette } from '../src/components/PaletteStyleTag/helpers/getPalette.ts';

const file = join(import.meta.dirname, '../src/styles/palette.scss');

const light = Object.entries(getThemePalette('light'));
for (const [color, value] of light) {
	// A Sass color literal, which the map holds unquoted
	if (!/^#(?:[\da-f]{6}|[\da-f]{8})$/i.test(value)) {
		throw new Error(`The light palette gives ${color} ${value}, which is not a hex color`);
	}
}

const source = `// generated by scripts/generate-palette.mts from the light palette of PaletteStyleTag, do not edit

$light: (${light.map(([color, value]) => `'${color}': ${value}`).join(',\n')});
`;

const read = (path: string) => {
	try {
		return readFileSync(path, 'utf8');
	} catch {
		return '';
	}
};

const name = file.slice(file.indexOf('src/'));
const next = await prettier.format(source, { ...((await prettier.resolveConfig(file)) ?? {}), parser: 'scss' });

if (next === read(file)) {
	console.log(`${name} is up to date`);
} else if (process.argv.includes('--check')) {
	console.error(`${name} is out of date: run \`yarn generate:palette\``);
	process.exit(1);
} else {
	writeFileSync(file, next);
	console.log(`${name} written`);
}
