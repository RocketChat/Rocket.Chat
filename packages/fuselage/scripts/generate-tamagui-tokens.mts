// Writes the tokens and themes of the Tamagui config from `@rocket.chat/fuselage-tokens`.
//
//   yarn generate:tamagui-tokens          rewrite src/tamagui.tokens.ts and src/styles/tamagui-tokens.css
//   yarn generate:tamagui-tokens --check  fail if one is stale (what `yarn test:verify` runs)
//
// The config imports the result instead of computing it, so every token and theme key is a literal type. Run it after
// building `@rocket.chat/fuselage-tokens`.
//
// The stylesheet keeps token variables available to runtime builds that do not render a `TamaguiProvider`.
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

import border from '@rocket.chat/fuselage-tokens/dist/border.json';
import size from '@rocket.chat/fuselage-tokens/dist/size.json';
import spacing from '@rocket.chat/fuselage-tokens/dist/spacing.json';
import typography from '@rocket.chat/fuselage-tokens/dist/typography.json';
import zIndex from '@rocket.chat/fuselage-tokens/dist/zIndex.json';
import prettier from 'prettier';

import { toRem } from './frame-values/lib/literal.mts';
import { themeKey } from '../src/components/PaletteStyleTag/helpers/convertToCss.ts';
import { getThemePalette } from '../src/components/PaletteStyleTag/helpers/getPalette.ts';

const file = join(import.meta.dirname, '../src/tamagui.tokens.ts');

// The base palette is left out of the `color` tokens: Tamagui adds every one of them to every theme as an unprefixed key,
// which the palette writer would then have to supply too.

// Tamagui rejects a token named after a CSS-wide keyword.
const RENAMED_RADII: Record<string, string> = { none: 'zero' };

const radius = Object.fromEntries(Object.entries(border.radius).map(([name, value]) => [RENAMED_RADII[name] ?? name, value]));

/** The palette `PaletteStyleTag` writes as `--rcx-color-*`, under the keys a frame reads it by. */
const theme = (name: Parameters<typeof getThemePalette>[0]) => {
	const entries = Object.entries<string>(getThemePalette(name)).map(([color, value]): [string, string] => [themeKey(color), value]);
	const keys = new Set(entries.map(([key]) => key));
	if (keys.size !== entries.length) {
		throw new Error(`The ${name} palette names a color twice`);
	}
	return Object.fromEntries(entries);
};

const themes = { 'light': theme('light'), 'dark': theme('dark'), 'high-contrast': theme('high-contrast') };

const keysOf = (value: object) => Object.keys(value).join();
if (keysOf(themes.light) !== keysOf(themes.dark) || keysOf(themes.light) !== keysOf(themes['high-contrast'])) {
	throw new Error('The light, dark and high-contrast palettes do not hold the same colors');
}

const tokens = { space: spacing, size, radius, zIndex };

// The stylesheets these tokens replace wrote a size and a radius in `rem` and a spacing in pixels.
const IN_REM: ReadonlySet<string> = new Set(['size', 'radius']);

// A weight is a string: Tamagui gives a numeric one a pixel unit.
const fontScale = Object.fromEntries(
	Object.entries(typography.fontScale).map(([name, { fontSize, lineHeight, fontWeight, letterSpacing }]) => [
		name,
		{ fontSize, lineHeight, fontWeight: String(fontWeight), letterSpacing },
	]),
);

const webTokens = Object.fromEntries(
	Object.entries(tokens).map(([category, values]) => [
		category,
		IN_REM.has(category) ? Object.fromEntries(Object.entries(values).map(([name, value]) => [name, toRem(value)])) : values,
	]),
);

// Tamagui's own names: `--t-<category>-<token>`, a number of pixels with its unit, a layer and a zero as plain numbers.
const variables = Object.entries(webTokens).flatMap(([category, values]) =>
	Object.entries<string | number>(values).map(
		([name, value]) =>
			`\t--t-${category}-${name}: ${value}${category === 'zIndex' || typeof value === 'string' || value === 0 ? '' : 'px'};`,
	),
);

const outputs = [
	{
		file,
		source: `// generated by scripts/generate-tamagui-tokens.mts from @rocket.chat/fuselage-tokens, do not edit

/** Lengths in density-independent pixels, as a native client reads them. */
export const tokens = ${JSON.stringify(tokens)} as const;

/** The same tokens for the web, in \`rem\` where a length follows the user's font size. */
export const webTokens = ${JSON.stringify(webTokens)} as const;

/**
 * The type scale, lengths in density-independent pixels. It is not a Tamagui font: on the web a font token compiles to
 * a variable declared only under the class of a \`TamaguiProvider\`, which Fuselage does not render, so a frame states
 * the values of its step.
 */
export const fontScale = ${JSON.stringify(fontScale)} as const;

export const themes = ${JSON.stringify(themes)} as const;
`,
		parser: 'typescript',
	},
	{
		file: join(import.meta.dirname, '../src/styles/tamagui-tokens.css'),
		source: `/* generated by scripts/generate-tamagui-tokens.mts from @rocket.chat/fuselage-tokens, do not edit */
:root {
${variables.join('\n')}
}
`,
		parser: 'css',
	},
];

const read = (path: string) => {
	try {
		return readFileSync(path, 'utf8');
	} catch {
		return '';
	}
};

let stale = false;
for (const output of outputs) {
	const name = output.file.slice(output.file.indexOf('src/'));
	const next = await prettier.format(output.source, { ...((await prettier.resolveConfig(output.file)) ?? {}), parser: output.parser });

	if (next === read(output.file)) {
		console.log(`${name} is up to date`);
	} else if (process.argv.includes('--check')) {
		console.error(`${name} is out of date: run \`yarn generate:tamagui-tokens\``);
		stale = true;
	} else {
		writeFileSync(output.file, next);
		console.log(`${name} written`);
	}
}

process.exit(stale ? 1 : 0);
