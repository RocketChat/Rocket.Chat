				selected: { backgroundColor: itemTokens.selected },
				disabled: { backgroundColor: 'transparent', cursor: 'not-allowed' },
			},
			// A row whose owner moves focus (`focusVisible`) draws its ring from `Item.styles.css`
			ring: {
