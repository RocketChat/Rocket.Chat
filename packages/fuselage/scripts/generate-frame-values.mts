				...font('p2'),
			},
			{
				elevation: {
					'0': { boxShadow: 'none' },
					'1': { boxShadow: `0 0 12px 0 ${shadowColors['shadow-elevation-1']}`, ...border },
					'2': {
						boxShadow: `0 0 2px 0 ${shadowColors['shadow-elevation-2x']}, 0 0 12px 0 ${shadowColors['shadow-elevation-2y']}`,
						...border,
					},
					'1nb': {},
					'2nb': {},
				},
			},
		)
