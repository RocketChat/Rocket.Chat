		borderWidth: 0,
		borderStyle: 'solid',
		borderRadius: toCSSValue('--rcx-button-border-radius', toCSSValue('--rcx-border-radius-medium', borderRadius('medium')!)),
		fontFamily: fontFamily('sans')!,
		...font('p2'),
