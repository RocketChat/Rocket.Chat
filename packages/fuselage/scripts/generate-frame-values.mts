for (const [dir, control] of [
	['CheckBox', checkBox],
	['RadioButton', radioButton],
	['ToggleSwitch', toggleSwitch],
] as const) {
	const base = join(import.meta.dirname, `../src/components/${dir}/${dir}`);
	components.push(
		{ file: `${base}.tsx`, generate: () => selectionFrames(control) },
		{ file: `${base}.styles.css`, generate: () => selectionStates(control), css: true },
	);
}
const check = process.argv.includes('--check');
let stale = false;

for (const { file, generate, css } of components) {
	const source = readFileSync(file, 'utf8');
	const [START, END] = css ? [CSS_START, CSS_END] : [TS_START, TS_END];
	const start = source.indexOf(START);
	const end = source.indexOf(END);

	if (start === -1 || end === -1) {
		throw new Error(`${file} has no generated section: add the ${startMarker} and ${endMarker} markers`);
	}

	const config = (await prettier.resolveConfig(file)) ?? {};
	const body = await prettier.format(generate(), { ...config, parser: css ? 'css' : 'typescript' });
	const next = `${source.slice(0, start)}${START}\n\n${body}\n${source.slice(end)}`;

	if (next !== source) {
		if (check) {
			console.error(`${file} is out of date: run \`yarn generate:frame-values\``);
			stale = true;
		} else {
			writeFileSync(file, next);
		}
	}
}

process.exit(stale ? 1 : 0);
