                              class="rcx-box rcx-box--full rcx-icon--name-phone rcx-icon rcx-css-1tg7yd0"
                            >
                              
                            </i>
                          </button>
                          <button
                            aria-label="Reject call from support"
                            class="rcx-box rcx-box--full rcx-button--mini-square rcx-button--icon-secondary-danger rcx-button--square rcx-button--icon rcx-button"
                            type="button"
                          >
                            <i
                              aria-hidden="true"
                              class="rcx-box rcx-box--full rcx-icon--name-phone-off rcx-icon rcx-css-1tg7yd0"
                            >
                              
                            </i>
                          </button>
                        </div>
                        <div
                          class="rcx-item__actions rcx-item__actions--reveal-hover rcx-sidebar-item__menu-wrapper"
                        >
                          <div
                            class="rcx-item__actions-inner"
