{
	"name": "@rocket.chat/fuselage",
	"version": "0.96.0",
	"description": "Rocket.Chat's React Components Library",
	"keywords": [
		"react",
		"components",
		"design-system",
		"fuselage",
		"rocket.chat"
	],
	"homepage": "https://github.com/RocketChat/Rocket.Chat#readme",
	"bugs": {
		"url": "https://github.com/RocketChat/Rocket.Chat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/fuselage"
	},
	"license": "MIT",
	"author": {
		"name": "Rocket.Chat",
		"url": "https://rocket.chat/"
	},
	"main": "index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist",
		"/index.js"
	],
	"scripts": {
		"build": "rm -rf dist && vite build --mode development && vite build --mode production && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"build-storybook": "NODE_ENV=production storybook build",
		"lint": "yarn run -T oxlint && yarn run stylelint",
		"lint:fix": "yarn run -T oxlint --fix && stylelint --fix '**/*.scss'",
		"stylelint": "stylelint --allow-empty-input '**/*.scss'",
		"start": "vite build --watch --mode development",
		"storybook": "storybook dev -p 6006 --no-version-updates",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit",
		"visual-regression": "visual-regression",
		"visual-regression-update": "visual-regression --update-snapshots"
	},
	"dependencies": {
		"@rocket.chat/css-in-js": "workspace:~",
		"@rocket.chat/fuselage-tokens": "workspace:^",
		"@rocket.chat/memo": "workspace:~",
		"invariant": "^2.2.4",
		"react-aria": "~3.37.0",
		"react-is": "~19.2.8",
		"react-keyed-flatten-children": "~5.1.3",
		"react-stately": "~3.35.0"
	},
	"devDependencies": {
		"@react-aria/ssr": "^3.9.7",
		"@rocket.chat/fuselage-hooks": "workspace:^",
		"@rocket.chat/icons": "workspace:~",
		"@rocket.chat/jest-presets": "workspace:~",
		"@rocket.chat/storybook-dark-mode": "workspace:~",
		"@rocket.chat/tsconfig": "workspace:~",
		"@rocket.chat/visual-regression": "workspace:~",
		"@storybook/addon-a11y": "~9.1.21",
		"@storybook/addon-docs": "~9.1.21",
		"@storybook/addon-styling-webpack": "~2.0.0",
		"@storybook/addon-webpack5-compiler-swc": "~4.0.3",
		"@storybook/react-webpack5": "~9.1.21",
		"@testing-library/dom": "~10.4.2",
		"@testing-library/react": "~16.3.3",
		"@testing-library/user-event": "~14.6.7",
		"@types/invariant": "^2.2.37",
		"@types/jest-axe": "~3.5.9",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"@types/react-is": "^19.2.0",
		"autoprefixer": "~10.5.6",
		"caniuse-lite": "~1.0.30001810",
		"cssnano": "~9.0.4",
		"jest": "~30.5.2",
		"jest-axe": "~11.0.0",
		"normalize.css": "^8.0.1",
		"postcss": "8.5.26",
		"postcss-loader": "~8.2.1",
		"postcss-scss": "~4.0.9",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"react-virtuoso": "~4.18.16",
		"resolve-url-loader": "~5.0.0",
		"sass": "~1.102.0",
		"sass-loader": "~17.0.1",
		"storybook": "~9.1.21",
		"stylelint": "~17.14.1",
		"stylelint-order": "~8.1.1",
		"stylelint-prettier": "~5.0.3",
		"stylelint-scss": "~7.2.0",
		"typescript": "~7.0.2",
		"vite": "~8.2.2"
	},
	"peerDependencies": {
		"@rocket.chat/fuselage-hooks": "*",
		"@rocket.chat/icons": "*",
		"react": ">=19",
		"react-dom": ">=19",
		"react-virtuoso": "*"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
