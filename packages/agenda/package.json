{
	"name": "@rocket.chat/agenda",
	"version": "0.1.1",
	"private": true,
	"description": "Fork of https://github.com/agenda/agenda",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"test": "yarn workspace @rocket.chat/jest-presets build && jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"config": {
		"mongodbMemoryServer": {
			"downloadDir": "../../node_modules/.cache/mongodb-memory-server",
			"preferGlobalPath": false
		}
	},
	"dependencies": {
		"cron": "~1.8.2",
		"date.js": "~0.3.3",
		"debug": "~4.3.7",
		"human-interval": "^2.0.1",
		"moment-timezone": "~0.5.48",
		"mongodb": "6.16.0"
	},
	"devDependencies": {
		"@rocket.chat/jest-presets": "workspace:~",
		"@types/debug": "^4.1.13",
		"jest": "~30.5.2",
		"mongodb-memory-server": "^10.2.3",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
