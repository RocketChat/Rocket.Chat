{
	"extends": "@rocket.chat/tsconfig/client.json",
	"compilerOptions": {
		"outDir": "./dist/esm"
	},
	// Deliberately empty: it clears the `**/*.spec.ts` exclusion inherited from
	// @rocket.chat/tsconfig, so `tsc --noEmit` covers the specs as well. Nothing
	// else typechecks them — the jest preset transpiles with @swc/jest — and the
	// build passes drop them through their own `exclude`.
	"exclude": [],
	"include": ["src/**/*"]
}
