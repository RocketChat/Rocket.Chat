{
	"extends": "@rocket.chat/tsconfig/client.json",
	"compilerOptions": {
		"types": ["node", "jest"],
		"rootDir": "./src",
		"target": "es2024",
		"lib": ["WebWorker"],
		"outDir": "./dist",
		"erasableSyntaxOnly": false,
		"isolatedModules": true,
		"noFallthroughCasesInSwitch": false
	},
	"include": ["src/**/*"],
	"exclude": ["./dist", "./jest.config.ts"]
}
