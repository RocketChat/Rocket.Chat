{
	"name": "@rocket.chat/storybook-dark-mode",
	"version": "4.3.0",
	"description": "Toggle between light and dark mode in Storybook (Rocket.Chat fork)",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/ts/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"./manager": "./manager.js",
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/storybook-dark-mode"
	},
	"license": "MIT",
	"author": "Andrew Lisowski <lisowski54@gmail.com>",
	"contributors": [
		"Rocket.Chat Technologies Corp."
	],
	"main": "./dist/esm/index.js",
	"types": "./dist/ts/index.d.ts",
	"files": [
		"src",
		"dist",
		"manager.js"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.build.json",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@storybook/global": "~5.0.0",
		"@storybook/icons": "~1.6.0",
		"fast-deep-equal": "~3.1.3"
	},
	"devDependencies": {
		"@rocket.chat/tsconfig": "workspace:~",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"storybook": "~9.1.21",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"react": "*",
		"react-dom": "*",
		"storybook": "^9.0.0"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
