{
	"name": "@rocket.chat/tracing",
	"version": "0.0.2",
	"private": true,
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "tsc --watch --preserveWatchOutput",
