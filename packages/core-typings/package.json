{
	"$schema": "https://json.schemastore.org/package",
	"name": "@rocket.chat/core-typings",
	"version": "9.0.0-develop",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RocketChat/Rocket.Chat.git",
		"directory": "packages/core-typings"
	},
	"license": "MIT",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		".:build:build": "ttsc --binary \"$(node -e 'const p=require(`path`);process.stdout.write(p.join(p.dirname(require.resolve(`@typescript/native-preview/package.json`)),`bin`,`tsgo`))')\" -p tsconfig.json",
		".:build:clean": "rimraf dist",
		"build": "run-s .:build:clean .:build:build",
		"dev": "ttsc --binary \"$(node -e 'const p=require(`path`);process.stdout.write(p.join(p.dirname(require.resolve(`@typescript/native-preview/package.json`)),`bin`,`tsgo`))')\" --watch --preserveWatchOutput -p tsconfig.json",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"testunit": "node --test --experimental-test-isolation=none --require tsx 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit --module preserve"
	},
	"dependencies": {
		"@rocket.chat/fuselage": "workspace:^",
		"@rocket.chat/icons": "workspace:~",
		"@rocket.chat/message-parser": "workspace:^",
		"@rocket.chat/ui-kit": "workspace:~",
		"typia": "13.0.2",
		"zod": "~4.3.6"
	},
	"devDependencies": {
		"@rocket.chat/apps-engine": "workspace:^",
		"@types/express": "^4.17.25",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"mongodb": "6.16.0",
		"npm-run-all": "~4.1.5",
		"rimraf": "^6.0.1",
		"tsx": "~4.22.5",
		"ttsc": "0.18.4",
		"typescript": "~5.9.3"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
