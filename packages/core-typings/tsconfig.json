{
	"extends": "@rocket.chat/tsconfig/server.json",
	"compilerOptions": {
		"lib": ["es2023", "dom", "dom.iterable"],
		"declaration": true,
		"rootDir": "./src",
		"outDir": "./dist",
		// ttsc/TS7 build: pinned here (not only in the shared base) because this
		// package still carries TS5.9 for typia's toolchain.
		"target": "es2022",
		"moduleResolution": "bundler",
		"types": ["node"],
		"plugins": [{ "transform": "typia/lib/transform" }]
	},
	"include": ["./src/**/*"]
}
