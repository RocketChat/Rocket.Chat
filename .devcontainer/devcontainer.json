{
	"name": "Rocket.Chat Dev",
	// The second file is generated on the host by initializeCommand (below) and
	// is gitignored. It carries the git-dir bind mount needed when this checkout
	// is a linked worktree, and is an empty stub otherwise. Listed
	// unconditionally because compose file lists cannot be computed.
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.worktree.yml"
	],
	// Must run before the container is created: it writes the override file that
	// the line above depends on. See the script for what breaks without it.
	"initializeCommand": "bash '${localWorkspaceFolder}/.devcontainer/init-worktree.sh'",
	"service": "app",
	"workspaceFolder": "/workspaces/rocket.chat",
	// Non-root user is required for `claude --dangerously-skip-permissions`,
	// and its uid (1000) matches the host user so bind-mounted files stay writable.
	"remoteUser": "vscode",
	"features": {
		// Installs the Claude Code CLI (and its VS Code extension) into the container.
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// Installs the GitHub CLI (gh).
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Optional features for DX - uncomment the ones you want
		// "ghcr.io/devcontainer-community/devcontainer-features/neovim.io:1": {},
		"ghcr.io/devcontainers-extra/features/npm-packages:1": {
			"packages": [
				"@rocket.chat/apps-cli",
				"gitnexus"
			]
		}
	},
	// Persist Claude Code auth/settings/history across container rebuilds.
	// Scoped per-devcontainer so different projects don't share credentials.
	"mounts": [
		// Your host Neovim config, read-only so the container can't modify it.
		// "source=${localEnv:HOME}/.config/nvim,target=/home/vscode/.config/nvim,type=bind,readonly",
		// Plugins/treesitter parsers stay container-side (arch-specific) and persist.
		// "source=nvim-data-${devcontainerId},target=/home/vscode/.local/share/nvim,type=volume",
		"source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
	],
	// Named volumes mount as root, and Docker also creates any *missing parent*
	// dirs of a mount target as root before the container runs — .local and
	// .local/share are not in the base image, so they exist only because of the
	// nvim volume nested under them. Chown from .local down, or the vscode user
	// cannot create ~/.local/state (nvim's shada/undo/logs) or ~/.local/bin.
	// Deliberately targeted rather than all of /home/vscode: a recursive chown
	// there would walk into the .config/nvim bind mount and rewrite ownership of
	// the host's files.
	//
	// The rc-node-modules and rc-meteor-local volumes are the same story: the
	// image has nothing at those paths to seed ownership from (the workspace only
	// exists as a bind mount at runtime), so they land as root:root and
	// yarn/meteor — running as vscode — get EACCES creating anything under them.
	// These target the volumes, NOT the host repo: each named volume is mounted
	// over the bind mount at its path, so the host's own node_modules and
	// .meteor/local are shadowed and untouched.
	// Not recursive: yarn and meteor create everything below as vscode, so only
	// the mount points themselves need fixing, and a recursive walk of a
	// populated node_modules would add minutes to every container create.
	//
	// This is onCreate rather than postCreate because updateContentCommand runs
	// *between* the two, and it needs the volumes to already be writable.
	//
	// The git config is a safety belt for the worktree setup: the container can
	// see the shared git dir but not the *other* worktrees' host paths, so from
	// in here they all look like they "point to a non-existent location" and
	// become prune candidates once past gc.worktreePruneExpire (default 3
	// months). A routine `git gc` inside the container would then unregister
	// worktrees that are perfectly healthy on the host — verified: it really
	// does list all of them as removable.
	//
	// This covers `git gc`/`gc --auto`, which pass this value through as
	// --expire. It does NOT cover an explicit `git worktree prune`: that
	// defaults to expiring everything and ignores the config. Don't run it in
	// here.
	"onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && sudo chown vscode:vscode /workspaces/rocket.chat/node_modules /workspaces/rocket.chat/apps/meteor/.meteor/local && git config --global gc.worktreePruneExpire never",
	// Dependencies and build artifacts are content, not image: they live in the
	// rc-node-modules volume and in each package's dist/, so they survive restarts
	// and only need rebuilding when the repo content changes. Running here (rather
	// than postCreate) also means prebuilds can bake the result into the image.
	// Note this runs before postStartCommand, i.e. before the egress firewall is
	// applied — which is what lets yarn reach the npm registry unimpeded.
	"updateContentCommand": "yarn install && yarn build",
	// Re-apply the egress firewall on every start (iptables state is not persisted).
	// This is what makes `claude --dangerously-skip-permissions` safe to run here:
	// egress is default-deny except for the allowlist in init-firewall.sh.
	// The script is baked into the image, so editing it requires a rebuild.
	// Deliberately rc-prefixed: the claude-code feature installs its own
	// /usr/local/bin/init-firewall.sh over ours (see the Dockerfile).
	"postStartCommand": "sudo /usr/local/bin/rc-init-firewall.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode"
			]
		}
	}
}
