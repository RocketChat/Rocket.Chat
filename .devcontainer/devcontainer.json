{
	"name": "Rocket.Chat Dev",
	// The second file is generated on the host by initializeCommand (below) and
	// is gitignored. It carries the git-dir bind mount needed when this checkout
	// is a linked worktree, and is an empty stub otherwise. Listed
	// unconditionally because compose file lists cannot be computed.
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.worktree.yml"
	],
	// Generates the override file the line above depends on, and brings up the
	// shared remote cache whose network this compose project attaches to as
	// external. Both must happen before the container is created — see the
	// script for what breaks without them.
	"initializeCommand": "bash '${localWorkspaceFolder}/.devcontainer/scripts/initialize.sh'",
	"service": "app",
	"workspaceFolder": "/workspaces/rocket.chat",
	// Non-root user is required for `claude --dangerously-skip-permissions`,
	// and its uid (1000) matches the host user so bind-mounted files stay writable.
	"remoteUser": "vscode",
	"features": {
		// Installs the Claude Code CLI (and its VS Code extension) into the container.
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// Installs the GitHub CLI (gh).
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Optional features for DX - uncomment the ones you want
		// "ghcr.io/devcontainer-community/devcontainer-features/neovim.io:1": {},
		"ghcr.io/devcontainers-extra/features/npm-packages:1": {
			"packages": [
				"@rocket.chat/apps-cli",
				"gitnexus"
			]
		}
	},
	// Point turbo at the shared remote cache (turbo-cache/docker-compose.yml).
	// Resolved by container name over the shared turbo-cache network, so the same
	// three values work from every worktree with no host-specific address.
	// TURBO_TOKEN must match the server's; TURBO_TEAM is only a namespace key for
	// artifacts and needs no `team_` prefix. TURBO_* vars are excluded from
	// turbo's task hashes, so setting them does not invalidate anything.
	//
	// These three ARE the hookup — they are the env equivalent of what
	// `turbo login` / `turbo link` persist to disk, and no lifecycle hook runs
	// them. Don't try to: both are TTY-only prompts with no non-interactive
	// flag (`--manual` literally means "type the token at a prompt"), so they
	// fail with "IO error: not a terminal" from any hook, and turbo isn't even
	// installed until updateContentCommand's yarn install. Verified working as
	// they stand: with the local cache wiped, turbo reports `Remote caching
	// enabled` and a remote `cache hit, replaying logs`.
	//
	// If you ever do write turbo's own config instead, set only `apiurl` and
	// `teamslug` in .turbo/config.json — adding `teamid` makes turbo request
	// ?teamId=...&slug=..., a different artifact namespace on the cache server,
	// which 404s against everything uploaded so far.
	//
	// TURBO_CACHE_DIR pins the *local* cache to this checkout, and is required
	// in a linked worktree. turbo 2.9 is worktree-aware: run from a linked
	// worktree it deliberately puts the local cache in the MAIN worktree, so
	// every worktree on a machine shares one directory. That path is a HOST
	// path, and in here only the main checkout's .git is bind-mounted — Docker
	// auto-creates its parent dirs as root, so turbo dies with
	// "failed to create directory .../main/.turbo/cache: Permission denied".
	// Sharing is the remote cache's job in this container anyway.
	// Relative, so it resolves to whatever the repo root is (/workspaces/
	// rocket.chat) and stays correct in every worktree.
	//
	// YARN_ENABLE_GLOBAL_CACHE points yarn at the shared rc-yarn-cache volume
	// mounted at ~/.yarn/berry (docker-compose.yml). The repo's .yarnrc.yml sets
	// `enableGlobalCache: false`, i.e. the cache belongs to the project — that is
	// right on a host, wrong in here: the project cache sits in the bind mount, so
	// every worktree writes its own ~350MB of zips through it and none of them
	// share. Env wins over .yarnrc.yml, so this overrides the setting for the
	// container only and leaves the checked-in config (and CI) alone.
	// Confirm with `yarn config get cacheFolder` — it should print
	// /home/vscode/.yarn/berry/cache, not a path under /workspaces.
	//
	// Note this is not the same as yarn's mirror: with the global cache off, yarn
	// still keeps a copy in ~/.yarn/berry (enableMirror, on by default), which the
	// mount alone would already share — but it would then *also* copy everything
	// into the project cache. Enabling the global cache skips that second copy.
	"containerEnv": {
		"TURBO_API": "http://turbo-cache:3000",
		"TURBO_TEAM": "rocketchat",
		"TURBO_TOKEN": "rocketchat-local-dev",
		"TURBO_CACHE_DIR": ".turbo/cache",
		"YARN_ENABLE_GLOBAL_CACHE": "true"
	},
	// Claude Code's ~/.claude is NOT here: it is a subpath of the external
	// rc-claude-config volume, declared in docker-compose.yml, so that one login
	// covers every worktree. A `mounts` entry cannot do that — the devcontainer
	// CLI folds these into a generated compose override, where they become
	// ordinary volumes namespaced per compose project (i.e. per worktree). Same
	// story as the shared gh/ssh mounts.
	"mounts": [
		// Your host Neovim config, read-only so the container can't modify it.
		// "source=${localEnv:HOME}/.config/nvim,target=/home/vscode/.config/nvim,type=bind,readonly",
		// Plugins/treesitter parsers stay container-side (arch-specific) and persist.
		// "source=nvim-data-${devcontainerId},target=/home/vscode/.local/share/nvim,type=volume",
	],
	// Fixes ownership of the named volumes (which mount as root) and stops
	// `git gc` from pruning the other worktrees, which are invisible from in
	// here. See the script for why each step is needed.
	"onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/on-create.sh",
	// Dependencies and build artifacts are content, not image: they live in the
	// rc-node-modules volume and in each package's dist/, so they survive restarts
	// and only need rebuilding when the repo content changes.
	//
	// Placed here for the ordering: it runs after onCreateCommand, which is what
	// makes the rc-node-modules and rc-meteor-local mount points writable by
	// `vscode` (see scripts/on-create.sh), and before postStartCommand, i.e.
	// before the egress firewall is applied — which is what lets yarn reach the
	// npm registry unimpeded.
	//
	// Do NOT expect a published/prebuilt image to carry the result of this. Both
	// of its outputs are unreachable from an image build: the rc-node-modules
	// volume, and dist/ on the bind mount. /workspaces/rocket.chat exists only as
	// a runtime bind mount, so there is nothing at those paths in any image layer
	// — the same fact on-create.sh relies on when it explains why those volumes
	// land root-owned. Baking this step works only where the *container disk
	// state* is snapshotted (Codespaces prebuilds), not for a plain
	// `devcontainer build --push` to a registry.
	"updateContentCommand": "yarn install && yarn build",
	// Re-apply the egress firewall on every start (iptables state is not persisted).
	// This is what makes `claude --dangerously-skip-permissions` safe to run here:
	// egress is default-deny except for the allowlist in init-firewall.sh.
	// Run from the workspace bind mount rather than a copy in the image, so
	// editing the allowlist only needs a container restart. Invoked via `bash`
	// because the exec bit comes from the host checkout and can't be relied on.
	// Note this is our own script, not the /usr/local/bin/init-firewall.sh that
	// the claude-code feature installs — that one is unused here.
	//
	// Object form runs the entries in parallel; they are independent (one touches
	// iptables, the other only copies files under ~/.claude).
	"postStartCommand": {
		"firewall": "sudo bash ${containerWorkspaceFolder}/.devcontainer/init-firewall.sh",
		// Installs the host's user-level skills, staged into the workspace by
		// initializeCommand. Here rather than onCreate so editing a skill on the
		// host takes effect on a restart.
		"skills": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/install-skills.sh"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode"
			]
		}
	}
}
