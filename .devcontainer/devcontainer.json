{
	"name": "Rocket.Chat Dev",
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.overrides.yml"
	],
	"service": "app",
	"workspaceFolder": "/workspaces/rocket.chat",
	// Non-root user is required for `claude --dangerously-skip-permissions`
	"remoteUser": "vscode",

	"initializeCommand": "bash '${localWorkspaceFolder}/.devcontainer/scripts/initialize.sh'",
	"onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/on-create.sh",
	"updateContentCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/update-content.sh",
	"postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/post-start.sh",

	// Optional features for DX — comment out the ones you don't want.

	// features can have additional setup scripts inside ./scripts/<feature name>
	// Check ./scripts/lib/features.sh for details
	"features": {
		"ghcr.io/devcontainers-extra/features/npm-packages:1": {
			"packages": [
				// rc-apps CLI for rocket.chat apps authoring
				"@rocket.chat/apps-cli"
			]
		},

		// Comment it out if you never run e2e tests — the apt packages, the shared
		// volume, its mount and the browser download all go with it.
		"ghcr.io/postfinance/devcontainer-features/playwright-deps:2": {
			"installChromiumDeps": true,
			"installFirefoxDeps": false,
			"installWebkitDeps": false
		}

		// Installs the GitHub CLI (gh).
		// ,"ghcr.io/devcontainers/features/github-cli:1": {}

		// Installs the Claude Code CLI (and its VS Code extension) into the container.
		//,"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"containerEnv": {
		// Turbo "remote" cache config - server is on docker-compose.yml
		// May also be used by the host, but beware of OS differences
		"TURBO_API": "http://turbo-cache:3000",
		"TURBO_TEAM": "rocketchat",
		"TURBO_TOKEN": "rocketchat-local-dev",
		// Prevent turbo from using worktree-aware cache resolution
		"TURBO_CACHE_DIR": ".turbo/cache",

		// Global cache for worktree sharing
		"YARN_ENABLE_GLOBAL_CACHE": "true"
	},
	// Many volumes are externally created by the features' hook scripts and contributed
	// to docker-compose.overrides.yml. This allows contents to be shared among worktrees
	"mounts": [],
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode"
			]
		}
	}
}
