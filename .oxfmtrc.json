{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"jsxSingleQuote": true,
	"printWidth": 140,
	"quoteProps": "consistent",
	"singleQuote": true,
	"trailingComma": "all",
	"useTabs": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/dist",
		"**/coverage",
		"**/storybook-static",
		".yarn/",
		"apps/meteor/**/public",
		"apps/meteor/**/private/moment-locales",
		"apps/meteor/**/imports",
		"apps/meteor/**/packages",
		"apps/meteor/.meteor/",
		"packages/apps/client",
		"packages/apps/definition",
		"packages/apps/docs",
		"packages/apps/server",
		"packages/apps/lib",
		"packages/apps-engine/client",
		"packages/apps-engine/definition",
		"packages/apps-engine/docs",
		"packages/apps-engine/server",
		"packages/apps-engine/lib",
		"packages/jest-presets/client/",
		"packages/jest-presets/server/",
		"packages/node-poplib/",
		"packages/storybook-config/*.d.ts",
		"packages/storybook-config/*.js",
		"scripts/",
		".github/",
		".houston/",
		"packages/fuselage/src/styles/colorPalette.scss"
	]
}
